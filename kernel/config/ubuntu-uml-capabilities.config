CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_WIREGUARD=y
CONFIG_NFS_FS=y
CONFIG_NFS_V3=y
CONFIG_NFS_V4=y
CONFIG_CIFS=y
# Keep the obsolete SMB1 dialect disabled.
